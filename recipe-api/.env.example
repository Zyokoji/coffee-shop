# OPTIONAL TODAY. Without a .env file the API uses built-in sample drinks.
#
# To use your own Supabase data on your laptop:
#   1. Copy this file and name the copy .env (same folder).
#   2. Paste in YOUR values (see where to find them below).
#   3. Stop the server (Ctrl + C) and run npm run dev again.
#
# .env is secret. It stays on your laptop: .gitignore keeps it out of git,
# and .vercelignore keeps it out of Vercel.

# Supabase dashboard: click Connect at the top. Looks like https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase dashboard: Project Settings, then API Keys, then Secret keys. Starts with sb_secret_
SUPABASE_SECRET_KEY=

# Websites (origins) allowed to read our responses from a browser.
# Comma separated. NO slash at the end of an origin.
CORS_ORIGINS=http://localhost:5173

PORT=3000
